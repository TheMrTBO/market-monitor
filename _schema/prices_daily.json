{
  "name": "prices_daily",
  "description": "Bougies journalières QQQ, IWM (Yahoo) et BTC (Coinbase)",
  "primary_key": [
    "symbol",
    "session_date"
  ],
  "partition": "month",
  "partition_by": "session_date",
  "columns": {
