{
  "name": "sectors_daily",
  "description": "Bougies journalières des ETF de config/sectors.toml (Yahoo)",
  "primary_key": [
    "symbol",
    "session_date"
  ],
  "partition": "month",
  "partition_by": "session_date",
  "columns": {
    "symbol": "text",
    "session_date": "date",
    "open": "float?",
    "high": "float?",
    "low": "float?",
    "close": "float?",
    "volume": "int?"
  }
}
