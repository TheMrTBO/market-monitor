# --- secrets et fichiers locaux : ne jamais publier ---
.env
.env.*
.venv/
.claude/
.DS_Store

# --- produits locaux, inutiles dans le depot ---
cache/
monitor_data.js
monitor_data.json
*.log
__pycache__/
_site/

# --- stockage historique : branche `data` extraite localement (git worktree), jamais sur main ---
data-store/

# --- fichiers générés par le robot (config/storage.toml [generated]) : publiés sur le site, jamais commités ---
